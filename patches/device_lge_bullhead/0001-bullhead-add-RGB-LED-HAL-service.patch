+#ifndef VENDOR_LINEAGE_RGBLED_V1_0_RGBLED_H
+#define VENDOR_LINEAGE_RGBLED_V1_0_RGBLED_H
+
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <hidl/Status.h>
+#include <vendor/lineage/rgbled/1.0/IRgbLed.h>
+
+namespace vendor {
+namespace lineage {
+namespace rgbled {
+namespace V1_0 {
+namespace implementation {
+
+using ::android::hardware::hidl_string;
+using ::android::hardware::hidl_vec;
+using ::android::hardware::Return;
+
+class RgbLed : public IRgbLed {
+  public:
+    Return<Status> setChannel(Channel channel, uint8_t brightness) override;
+    Return<Status> setColor(uint32_t rgb, uint8_t brightness) override;
+    Return<Status> setBlink(uint32_t rgb, uint8_t brightness, uint32_t onMs,
+                            uint32_t offMs) override;
+    Return<void> getSupportedTriggers(getSupportedTriggers_cb _hidl_cb) override;
+    Return<Status> setTrigger(Channel channel, const hidl_string& trigger) override;
+    Return<void> getTrigger(Channel channel, getTrigger_cb _hidl_cb) override;
+    Return<int32_t> getBrightness(Channel channel) override;
+    Return<Status> turnOff() override;
+
+  private:
+    Status writeAllLocked(uint32_t rgb, uint8_t brightness, uint32_t onMs, uint32_t offMs);
+    std::vector<std::string> readTriggers(Channel channel, std::string* active);
+
+    std::mutex mLock;
+};
+
+}  // namespace implementation
+}  // namespace V1_0
+}  // namespace rgbled
+}  // namespace lineage
+}  // namespace vendor
+
+#endif  // VENDOR_LINEAGE_RGBLED_V1_0_RGBLED_H
