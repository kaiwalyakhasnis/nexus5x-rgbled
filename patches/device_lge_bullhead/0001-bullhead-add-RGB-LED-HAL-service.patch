+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#define LOG_TAG "vendor.lineage.rgbled@1.0-service.bullhead"
+
+#include <android-base/logging.h>
+#include <hidl/HidlTransportSupport.h>
+
+#include "RgbLed.h"
+
+using android::hardware::configureRpcThreadpool;
+using android::hardware::joinRpcThreadpool;
+using vendor::lineage::rgbled::V1_0::IRgbLed;
+using vendor::lineage::rgbled::V1_0::implementation::RgbLed;
+
+int main() {
+    android::sp<IRgbLed> service = new RgbLed();
+
+    configureRpcThreadpool(1, true /* callerWillJoin */);
+
+    if (service->registerAsService() != android::OK) {
+        LOG(ERROR) << "Cannot register RGB LED HAL service";
+        return 1;
+    }
+
+    LOG(INFO) << "RGB LED HAL service ready";
+    joinRpcThreadpool();
+
+    LOG(ERROR) << "RGB LED HAL service exited unexpectedly";
+    return 1;
+}
diff --git a/rgbled/vendor.lineage.rgbled@1.0-service.bullhead.rc b/rgbled/vendor.lineage.rgbled@1.0-service.bullhead.rc
new file mode 100644
index 0000000..a8591ed
--- /dev/null
+++ b/rgbled/vendor.lineage.rgbled@1.0-service.bullhead.rc
@@ -0,0 +1,9 @@
+on boot
+    chown system system /sys/class/leds/red/trigger
+    chown system system /sys/class/leds/green/trigger
+    chown system system /sys/class/leds/blue/trigger
+
+service vendor.rgbled-1-0 /system/bin/hw/vendor.lineage.rgbled@1.0-service.bullhead
+    class hal
+    user system
+    group system
