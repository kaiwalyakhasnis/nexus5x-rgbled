+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.server.rgbled;
+
+import android.Manifest;
+import android.content.Context;
+import android.hardware.rgbled.IRgbLedService;
+import android.hardware.rgbled.RgbLedManager;
+import android.os.RemoteException;
+import android.util.Slog;
+
+import com.android.internal.util.DumpUtils;
+import com.android.server.SystemService;
+
+import vendor.lineage.rgbled.V1_0.IRgbLed;
+import vendor.lineage.rgbled.V1_0.Status;
+
+import java.io.FileDescriptor;
+import java.io.PrintWriter;
+import java.util.ArrayList;
+import java.util.NoSuchElementException;
+
+public class RgbLedService extends SystemService {
+    private static final String TAG = "RgbLedService";
+
+    private final Object mLock = new Object();
+    private IRgbLed mHal;
+
+    public RgbLedService(Context context) {
+        super(context);
+    }
+
+    @Override
+    public void onStart() {
+        publishBinderService(Context.RGB_LED_SERVICE, new BinderService());
+    }
+
+    private IRgbLed getHal() {
+        synchronized (mLock) {
+            if (mHal == null) {
+                try {
+                    mHal = IRgbLed.getService();
+                    mHal.linkToDeath(cookie -> {
+                        Slog.w(TAG, "RGB LED HAL died");
+                        synchronized (mLock) {
+                            mHal = null;
+                        }
+                    }, 0);
+                } catch (RemoteException | NoSuchElementException e) {
+                    Slog.w(TAG, "RGB LED HAL not available", e);
+                    mHal = null;
+                }
+            }
+            return mHal;
+        }
+    }
+
+    private static void checkChannel(int channel) {
+        if (channel < RgbLedManager.CHANNEL_RED || channel > RgbLedManager.CHANNEL_BLUE) {
+            throw new IllegalArgumentException("Invalid channel " + channel);
+        }
+    }
+
+    private static void checkBrightness(int brightness) {
+        if (brightness < 0 || brightness > 255) {
+            throw new IllegalArgumentException("Brightness must be 0-255, was " + brightness);
+        }
+    }
+
+    private final class BinderService extends IRgbLedService.Stub {
+        private void enforceControl() {
+            getContext().enforceCallingOrSelfPermission(
+                    Manifest.permission.CONTROL_RGB_LED, "Controlling the RGB LED");
+        }
+
+        @Override
+        public boolean isAvailable() {
+            return getHal() != null;
+        }
+
+        @Override
+        public boolean setChannel(int channel, int brightness) {
+            enforceControl();
+            checkChannel(channel);
+            checkBrightness(brightness);
+            IRgbLed hal = getHal();
+            try {
+                return hal != null && hal.setChannel(channel, (byte) brightness) == Status.SUCCESS;
+            } catch (RemoteException e) {
+                Slog.e(TAG, "setChannel failed", e);
+                return false;
+            }
+        }
+
+        @Override
+        public boolean setColor(int rgb, int brightness) {
+            enforceControl();
+            checkBrightness(brightness);
+            IRgbLed hal = getHal();
+            try {
+                return hal != null
+                        && hal.setColor(rgb & 0xffffff, (byte) brightness) == Status.SUCCESS;
+            } catch (RemoteException e) {
+                Slog.e(TAG, "setColor failed", e);
+                return false;
+            }
+        }
+
+        @Override
+        public boolean setBlink(int rgb, int brightness, int onMs, int offMs) {
+            enforceControl();
+            checkBrightness(brightness);
+            if (onMs < RgbLedManager.MIN_BLINK_ON_MS || onMs > RgbLedManager.MAX_BLINK_MS
+                    || offMs < 0 || offMs > RgbLedManager.MAX_BLINK_MS) {
+                throw new IllegalArgumentException("Invalid blink timing " + onMs + "/" + offMs);
+            }
+            IRgbLed hal = getHal();
+            try {
+                return hal != null && hal.setBlink(rgb & 0xffffff, (byte) brightness, onMs, offMs)
+                        == Status.SUCCESS;
+            } catch (RemoteException e) {
+                Slog.e(TAG, "setBlink failed", e);
+                return false;
+            }
+        }
+
+        @Override
+        public String[] getSupportedTriggers() {
+            IRgbLed hal = getHal();
+            try {
+                if (hal == null) return new String[0];
+                ArrayList<String> triggers = hal.getSupportedTriggers();
+                return triggers.toArray(new String[triggers.size()]);
+            } catch (RemoteException e) {
+                Slog.e(TAG, "getSupportedTriggers failed", e);
+                return new String[0];
+            }
+        }
+
+        @Override
+        public boolean setTrigger(int channel, String trigger) {
+            enforceControl();
+            checkChannel(channel);
+            if (trigger == null || trigger.isEmpty()) {
+                throw new IllegalArgumentException("Trigger must not be empty");
+            }
+            IRgbLed hal = getHal();
+            try {
+                return hal != null && hal.setTrigger(channel, trigger) == Status.SUCCESS;
+            } catch (RemoteException e) {
+                Slog.e(TAG, "setTrigger failed", e);
+                return false;
+            }
+        }
+
+        @Override
+        public String getTrigger(int channel) {
+            checkChannel(channel);
+            IRgbLed hal = getHal();
+            try {
+                return hal != null ? hal.getTrigger(channel) : null;
+            } catch (RemoteException e) {
+                Slog.e(TAG, "getTrigger failed", e);
+                return null;
+            }
+        }
+
+        @Override
+        public int getBrightness(int channel) {
+            checkChannel(channel);
+            IRgbLed hal = getHal();
+            try {
+                return hal != null ? hal.getBrightness(channel) : -1;
+            } catch (RemoteException e) {
+                Slog.e(TAG, "getBrightness failed", e);
+                return -1;
+            }
+        }
+
+        @Override
+        public boolean turnOff() {
+            enforceControl();
+            IRgbLed hal = getHal();
+            try {
+                return hal != null && hal.turnOff() == Status.SUCCESS;
+            } catch (RemoteException e) {
+                Slog.e(TAG, "turnOff failed", e);
+                return false;
+            }
+        }
+
+        @Override
+        protected void dump(FileDescriptor fd, PrintWriter pw, String[] args) {
+            if (!DumpUtils.checkDumpPermission(getContext(), TAG, pw)) return;
+            pw.println("RGB LED service");
+            pw.println("  HAL available: " + isAvailable());
+            String[] names = {"red", "green", "blue"};
+            for (int c = RgbLedManager.CHANNEL_RED; c <= RgbLedManager.CHANNEL_BLUE; c++) {
+                pw.println("  " + names[c] + ": brightness=" + getBrightness(c)
+                        + " trigger=" + getTrigger(c));
+            }
+        }
+    }
+}
